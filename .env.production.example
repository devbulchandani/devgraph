# DevGraph Production Environment Variables

# Node Environment
NODE_ENV=production

# Server Configuration
PORT=4000

# FalkorDB Configuration
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_GRAPH_ID=devgraph

# AI Provider (Optional - will use deterministic fallback if not set)
GEMINI_API_KEY=your-gemini-api-key-here

# Frontend API URL (for CORS)
FRONTEND_URL=https://your-domain.com

# Logging
LOG_LEVEL=info
